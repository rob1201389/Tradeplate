# ---------------------------------------------------------------------------
# Database. Use a provider with an Australian region (see README).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Office/admin password: viewing and exporting every record, managing plates.
ADMIN_PASSWORD="change-me"

# Random 32+ character string that signs the session cookies. Changing it signs
# everyone out.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional shared PIN on the driver forms. Leave blank and anyone holding a
# plate's QR link can write a record; set it and each phone is asked once every
# 60 days. Recommended.
DRIVER_PIN=""

# ---------------------------------------------------------------------------
# Public URL, used when generating the QR codes you print and stick on plates.
# Get this right before printing - the QR encodes it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="https://tradeplate.example.com"

# ---------------------------------------------------------------------------
# Who the privacy notice names, and how long records are kept.
# ---------------------------------------------------------------------------
ORG_NAME="Your Business Pty Ltd"
PRIVACY_CONTACT="the Privacy Officer"
PRIVACY_CONTACT_EMAIL="privacy@example.com"
PRIVACY_CONTACT_PHONE=""
RETENTION_YEARS="5"
